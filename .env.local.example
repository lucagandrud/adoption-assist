# Copy to .env.local and fill in when Supabase replaces the local JSON store.
# .env.local is gitignored — never commit real keys.

# Supabase (lib/supabase.ts). Optional today: without these the app uses the
# local JSON store in lib/store.ts and everything still works.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Anthropic — document extraction (/extraction/pipeline.ts, handoff Step 5).
ANTHROPIC_API_KEY=

# Set to 1 to serve cached extraction results instead of calling the API.
# Rehearse the demo with this on: conference wifi fails.
EXTRACTION_USE_CACHE=0
