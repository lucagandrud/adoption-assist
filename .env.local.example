# Copy to .env.local and fill in. .env.local is gitignored — never commit it.
#
# LEAVE THESE BLANK and the app runs on local JSON storage with no setup at
# all: sign up, get a caseload, and it survives a restart. Fill them in and the
# same app runs on Postgres with real auth and row-level security.
#
# Setup walkthrough: docs/supabase-setup.md

# ---------------------------------------------------------------------------
# Supabase — Project Settings > API
# ---------------------------------------------------------------------------
# Both are safe in the browser. The anon key is not a secret: row-level
# security in supabase/migrations/0001_init.sql is what protects the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Anthropic — document extraction (handoff Step 5)
# ---------------------------------------------------------------------------
# SERVER ONLY. No NEXT_PUBLIC_ prefix, ever — that would ship the key to every
# visitor's browser.
ANTHROPIC_API_KEY=
