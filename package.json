{
  "name": "icpc-compliance-workbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "evaluate:extraction": "node --experimental-strip-types --experimental-specifier-resolution=node scripts/evaluate-extraction.mjs",
    "evaluate:extraction:live": "node --env-file-if-exists=.env.local --experimental-strip-types --experimental-specifier-resolution=node scripts/evaluate-extraction.mjs --live",
    "test:live-pipeline": "node --experimental-strip-types --experimental-specifier-resolution=node scripts/test-live-extraction.mjs",
    "verify:ontology": "node --experimental-strip-types --experimental-specifier-resolution=node scripts/verify-ontology.mjs",
    "verify:all": "npm run lint && npx tsc --noEmit && npm run verify:ontology && npm run evaluate:extraction && npm run test:live-pipeline && npm run build"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@supabase/ssr": "^0.12.6",
    "@supabase/supabase-js": "^2.115.0",
    "@xyflow/react": "^12.11.6",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.5",
    "dagre": "^0.8.5",
    "lucide-react": "^1.41.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/dagre": "^0.7.54",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
